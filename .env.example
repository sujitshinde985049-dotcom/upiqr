# MahaCred QR — Environment template (placeholders only; never commit real secrets)
# Copy to .env.local for local development.

# Runtime environment: development | test | production
NODE_ENV=development

# Neon PostgreSQL connection string (server-only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js / NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Optional canonical application URL for production redirects/callbacks
# APP_URL=https://your-app.example.com
# AUTH_URL=https://your-app.example.com

# Seed default password (development seeding only — not used at runtime)
SEED_DEFAULT_PASSWORD=

# SabPaisa SabQR — server-side only. LIVE credentials unavailable until onboarding.
SABPAISA_ENV=staging
SABPAISA_BASE_URL=
SABPAISA_API_KEY=
SABPAISA_API_SECRET=
SABPAISA_ENCRYPTION_MASTER_KEY=
SABPAISA_ENCRYPTION_HMAC_SECRET=

# Provider integration mode: mock (default, safe) | live (fail-closed until interoperability)
SABPAISA_MODE=mock

# Development/test-only mock fixtures (never enable in production)
ALLOW_MOCK_PAYMENT_EVENTS=false
ALLOW_MOCK_TRANSACTION_FIXTURES=false

# Block mutating DB verification scripts when explicitly configured (optional safety)
# DB_PRODUCTION_GUARD=true
# ALLOW_DB_TEST_MUTATIONS=false
