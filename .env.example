# MahaCred QR — Local Development Environment
# Copy to .env.local and adjust as needed. Never commit real secrets.

DATABASE_URL="postgresql://mahacred:mahacred_dev@localhost:5432/mahacred_qr?schema=public"

# Auth.js / NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET="dev-only-change-in-production-use-openssl-rand"

# Seed default password for all development users
SEED_DEFAULT_PASSWORD="DevPass@123"

# SabPaisa SabQR (Phase 4) — server-side only. Never commit real values.
# Default local development uses staging. No live SabPaisa calls in Phase 4 Part 1.
SABPAISA_ENV=staging
SABPAISA_BASE_URL=
SABPAISA_API_KEY=
SABPAISA_API_SECRET=
SABPAISA_ENCRYPTION_MASTER_KEY=
SABPAISA_ENCRYPTION_HMAC_SECRET=

# SabPaisa integration mode: mock (default) | live
# Live mode requires onboarding credentials and official encryption interoperability.
SABPAISA_MODE=mock
