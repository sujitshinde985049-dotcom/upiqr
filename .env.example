# MahaCred QR — Local Development Environment
# Copy to .env.local and adjust as needed. Never commit real secrets.

DATABASE_URL="postgresql://mahacred:mahacred_dev@localhost:5432/mahacred_qr?schema=public"

# Auth.js / NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET="dev-only-change-in-production-use-openssl-rand"

# Seed default password for all development users
SEED_DEFAULT_PASSWORD="DevPass@123"
