generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  CLIENT_OPERATOR
  MERCHANT_USER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ClientType {
  BANK
  PATSANSTHA
}

enum PaymentRail {
  HDFC
  ICICI
}

enum QRProviderMode {
  MOCK
  LIVE
  LEGACY
}

enum TransactionStatus {
  SUCCESS
  PENDING
  FAILED
}

enum PaymentEventProcessingStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

model User {
  id           String       @id
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole
  clientId     String?
  merchantId   String?
  status       EntityStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[]

  @@index([clientId])
  @@index([merchantId])
  @@index([role])
  @@index([status])
}

model Client {
  id                 String       @id
  clientCode         String       @unique
  name               String
  type               ClientType
  registrationNumber String?      @unique
  contactPerson      String
  mobile             String
  email              String
  address            String?
  city               String?
  district           String?
  state              String?
  pinCode            String?
  status             EntityStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users        User[]
  merchants    Merchant[]
  qrCodes      QRCode[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  settings     ClientSettings?

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Merchant {
  id                      String       @id
  merchantCode            String       @unique
  clientId                String
  businessName            String
  accountHolderName       String
  currentAccountReference String
  merchantCategory        String?
  businessType            String?
  gstNumber               String?
  pan                     String?
  mobile                  String
  email                   String?
  address                 String?
  city                    String?
  district                String?
  state                   String?
  pinCode                 String?
  status                  EntityStatus @default(PENDING)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  users        User[]
  qrCodes      QRCode[]
  transactions Transaction[]

  @@unique([clientId, currentAccountReference])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model QRCode {
  id                      String          @id
  clientId                String
  merchantId              String
  sabpaisaQrId            String?
  provider                String          @default("sabpaisa")
  providerMode            QRProviderMode  @default(LEGACY)
  qrName                  String
  qrIdentifier            String
  railId                  PaymentRail
  vpa                     String?
  qrImageUrl              String?
  upiString               String?
  maxAmountPerTransaction Decimal?        @db.Decimal(12, 2)
  description             String?
  category                String?
  notes                   String?
  isPayable               Boolean         @default(false)
  providerCreatedAt       DateTime?
  idempotencyKey          String?         @unique
  status                  EntityStatus    @default(ACTIVE)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([clientId, qrIdentifier])
  @@index([clientId])
  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id                    String            @id
  clientId              String
  merchantId            String
  qrId                  String
  transactionId         String            @unique
  provider              String            @default("sabpaisa")
  providerMode          QRProviderMode    @default(LEGACY)
  providerTransactionId String?
  amount                Decimal           @db.Decimal(12, 2)
  status                TransactionStatus
  railId                PaymentRail?
  customerVpa           String?
  customerName          String?
  referenceNumber       String?
  bankReferenceNumber   String?
  paymentMethod         String?
  initiatedAt           DateTime
  completedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  qrCode   QRCode   @relation(fields: [qrId], references: [id], onDelete: Cascade)
  paymentEvents PaymentEvent[]

  @@unique([provider, providerMode, providerTransactionId])
  @@index([clientId])
  @@index([merchantId])
  @@index([qrId])
  @@index([status])
  @@index([initiatedAt])
  @@index([clientId, status])
  @@index([merchantId, status])
  @@index([providerMode])
}

model PaymentEvent {
  id                    String                       @id
  provider              String                       @default("sabpaisa")
  providerMode          QRProviderMode
  providerEventId       String
  providerTransactionId String?
  eventType             String?
  processingStatus      PaymentEventProcessingStatus @default(RECEIVED)
  transactionId         String?
  qrId                  String?
  clientId              String?
  merchantId            String?
  failureReasonCode     String?
  receivedAt            DateTime
  processedAt           DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerMode, providerEventId])
  @@index([providerTransactionId])
  @@index([transactionId])
  @@index([processingStatus])
  @@index([receivedAt])
}

model PlatformSettings {
  id           String   @id @default("platform")
  platformName String   @default("MahaCred QR")
  supportEmail String   @default("support@mahacred.in")
  supportPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ClientSettings {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  emailNotifications Boolean  @default(true)
  transactionAlerts  Boolean  @default(true)
  weeklyReports      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  clientId   String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
